# Frontend Environment Variables
# For local development:
VITE_API_BASE_URL=http://127.0.0.1:4000

# For production (Vercel), set VITE_API_BASE_URL to your public HTTPS backend, e.g.:
# VITE_API_BASE_URL=https://api.your-domain.com

# CARTO basemap API key (optional).
# If omitted, falls back to Stadia Maps Alidade Smooth Dark (no key required).
# Obtain a free key at https://carto.com/developers/
# Restrict it to your Vercel domain for security.
# Set via: Vercel Dashboard → Project → Settings → Environment Variables
# NEVER commit the actual value here.
VITE_CARTO_API_KEY=
